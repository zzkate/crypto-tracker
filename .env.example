# Порт HTTP-сервера
PORT=3000

# Bearer-токен для доступа к собственному API (обязателен)
APP_API_KEY=change-me-please

# Ключ CoinMarketCap API (https://pro.coinmarketcap.com/)
CMC_API_KEY=

# База CoinMarketCap (можно переопределить для тестов/прокси)
CMC_BASE_URL=https://pro-api.coinmarketcap.com
CMC_TIMEOUT_MS=5000

# Интервал фоновой синхронизации цен, мс
SYNC_INTERVAL_MS=60000

# Валюта цен, единая для приложения
PRICE_CURRENCY=USD

# Путь к файлу SQLite
DB_PATH=data/crypto.db
