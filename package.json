{
  "name": "crypto-price-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Crypto price tracker backed by CoinMarketCap API",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "start:env": "node --env-file-if-exists=.env dist/server.js",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning jest --runInBand",
    "test:coverage": "NODE_OPTIONS=--disable-warning=ExperimentalWarning jest --runInBand --coverage",
    "test:e2e": "npm run build && NODE_OPTIONS=--disable-warning=ExperimentalWarning jest --config jest.e2e.config.js --runInBand"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "express": "^4.21.2",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.7",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  }
}
